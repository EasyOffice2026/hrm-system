# PostgreSQL connection string for the dedicated HRM Supabase project (Session pooler URI).
# Leave unset to fall back to a local SQLite file (backend/hrm.db) for development.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secret used to sign JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Optional
UPLOAD_DIR=./uploads
HRM_COMPANY_NAME=My Company
HRM_COMPANY_NAME_AR=شركتي
HRM_ADMIN_USER=admin
HRM_ADMIN_PASSWORD=change-me
